---
import {
  Trash,
  QrCode,
  ScanLine,
  Download,
  X,
  SwitchCamera,
} from '@lucide/astro';
import QrImageIntake from './QrImageIntake.astro';
import { copy } from '../lib/copy.ts';
import type { Lang } from '../lib/types.ts';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy(lang);
---

<section
  id="scanner"
  class="scanner"
  data-scanner
  data-lang={lang}
  aria-label="QR Scanner"
>
  <div class="input-pane">
    <div class="pane-heading">
      <h2>{t.inputTitle}</h2>
      <button
        class="button button-quiet"
        type="button"
        id="clear"
        disabled
        data-destructive-action
      >
        <Trash aria-hidden="true" />
        <span>{t.clear}</span>
      </button>
    </div>
    <QrImageIntake
      id="dropzone"
      pasteId="image-paste"
      fileId="file"
      chooseId="choose"
      pasteButtonId="paste"
      cameraId="start-camera"
      cameraControlsId="camera-section"
      cameraDescribedBy="camera-error"
      title={t.dropTitle}
      placeholder={t.pastePlaceholder}
      chooseLabel={t.choose}
      pasteLabel={t.paste}
      cameraLabel={t.cameraAction}
      describedBy="image-error"
      accept="image/png,image/jpeg,image/webp,image/gif,image/bmp,image/avif"
    />
    <p class="field-error" id="image-error" role="alert" hidden></p>
    <figure class="preview" id="preview" hidden>
      <img
        id="preview-image"
        src={import.meta.env.BASE_URL + 'brand/mark.svg'}
        alt={t.previewAlt}
        width="480"
        height="320"
      />
      <figcaption
        id="image-name"
        class="small muted"
        data-user-content
      ></figcaption>
    </figure>
    <details class="input-disclosure" id="url-section">
      <summary id="url-title">{t.urlTitle}</summary>
      <form id="url-form" novalidate>
        <div class="url-actions">
          <input
            id="image-url"
            type="url"
            inputmode="url"
            autocomplete="off"
            spellcheck="false"
            placeholder={t.urlPlaceholder}
            aria-labelledby="url-title"
            aria-describedby="url-help url-error"
            disabled
          />
          <button
            class="button button-secondary"
            type="submit"
            id="scan-url"
            disabled
          >
            <ScanLine aria-hidden="true" />
            {t.scanURL}
          </button>
        </div>
        <p class="field-error" id="url-error" role="alert" hidden></p>
        <p id="url-help" class="small muted">
          {t.urlHelp}
        </p>
      </form>
    </details>
    <p class="field-error" id="camera-error" role="alert" hidden></p>
    <div class="camera-section" id="camera-section" hidden>
      <div
        class="camera-preview"
        id="camera-preview"
        role="group"
        aria-label={t.videoLabel}
        hidden
      >
        <video id="video" aria-hidden="true" muted playsinline></video>
        <p class="small muted" id="camera-label" data-user-content></p>
      </div>
      <div class="button-row">
        <button
          class="button button-secondary"
          type="button"
          id="switch-camera"
          hidden
          disabled
        >
          <SwitchCamera aria-hidden="true" />
          <span>{t.switchCamera}</span>
        </button>
        <button
          class="button button-secondary"
          type="button"
          id="stop-camera"
          disabled
        >
          <X aria-hidden="true" />
          <span id="stop-camera-label">{t.cancelCamera}</span>
        </button>
      </div>
      <p id="camera-status" class="small" role="status"></p>
    </div>
    <p class="privacy small muted">{t.privacy}</p>
    <noscript>
      <p class="field-error">{t.noScript}</p>
    </noscript>
  </div>
  <div class="result-pane" aria-busy="false">
    <h2>{t.resultTitle}</h2>
    <div class="empty-result" id="empty">
      <QrCode aria-hidden="true" />
      <p class="muted">{t.empty}</p>
    </div>
    <p
      id="status"
      class="status small"
      role="status"
      aria-live="polite"
      aria-atomic="true"
    ></p>
    <div id="results" data-user-content></div>
    <button
      class="button button-secondary"
      type="button"
      id="download-results"
      hidden
      disabled
    >
      <Download aria-hidden="true" />
      {t.downloadJSON}
    </button>
  </div>
</section>
<section class="faq" aria-labelledby="faq-title">
  <h2 id="faq-title">{t.faqTitle}</h2>
  <details class="faq-item">
    <summary>{t.imageHelpTitle}</summary>
    <p>{t.dropHelp}</p>
    <p>{t.pasteHelp}</p>
    <p>{t.cameraHelp}</p>
  </details>
  {[1, 2, 3, 4].map((number) => (
    <details class="faq-item">
      <summary>{t[('faq' + String(number)) as 'faq1']}</summary>
      <p>{t[('answer' + String(number)) as 'answer1']}</p>
    </details>
  ))}
  <p class="small muted">
    <a href="https://github.com/Sec-ant/zxing-wasm" rel="noopener noreferrer">
      {t.references}
    </a>
  </p>
</section>
<aside class="related">
  <h2>{t.generatorTitle}</h2>
  <p class="muted">{t.generatorCopy}</p>
  <a href="https://qr.vinasig.io.vn/">{t.generatorLink}</a>
</aside>
<script>
  import '../scripts/scanner.ts';
</script>
